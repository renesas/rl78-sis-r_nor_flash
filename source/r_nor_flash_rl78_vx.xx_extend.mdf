<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<!--
/***********************************************************************************************************************
  Purpose: Module Description File (MDF) Example (Schema Version 2.0)
           This is a description of a sample FIT module configuration file
***********************************************************************************************************************/
-->
<module xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" schemaVersion="2.0" xs:noNamespaceSchemaLocation="schema_mdf_2.00.xsd">
    <fileVersion>1.00</fileVersion>
    <formatVersion>2.00</formatVersion>

    <fileTemplate></fileTemplate>
    <configuration>
        <property id="NOR_FLASH_CFG_PARAM_CHECKING_ENABLE" display="Parameter check" default="BSP_CFG_PARAM_CHECKING_ENABLE" type="combobox">
            <option id="NOR_FLASH_CFG_PARAM_CHECKING_ENABLE.0" display="Disable parameter checks" value="0"/>
            <option id="NOR_FLASH_CFG_PARAM_CHECKING_ENABLE.1" display="Enable parameter checks" value="1"/>
            <option id="NOR_FLASH_CFG_PARAM_CHECKING_ENABLE.BSP_CFG_PARAM_CHECKING_ENABLE" display="Use system default" value="BSP_CFG_PARAM_CHECKING_ENABLE"/>
            <description>Setting to BSP_CFG_PARAM_CHECKING_ENABLE utilizes the system default setting
Setting to 1 includes parameter checking; 0 compiles out parameter checking</description>
        </property>
        <property id="NOR_FLASH_CFG_WEL_CHK" display="ENABLE CHECKING OF THE WEL BIT." default="1" type="combobox">
            <option id="NOR_FLASH_CFG_WEL_CHK.0" display="Not check WEL bit" value="0"/>
            <option id="NOR_FLASH_CFG_WEL_CHK.1" display="Check WEL bit" value="1"/>
            <description>Selects whether or not the WEL bit is checked after the WREN
command is issued. (1: Enabled, 0: Disabled)</description>
        </property>
        <property id="NOR_FLASH_CFG_DEVICE" display="Select serial flash memory device" default="NOR_FLASH_TYPE_AT25SF" type="combobox">
            <option id="NOR_FLASH_CFG_DEVICE.NOR_FLASH_TYPE_AT25SF" display="Renesas Electronics AT25SF" value="NOR_FLASH_TYPE_AT25SF"/>
            <option id="NOR_FLASH_CFG_DEVICE.NOR_FLASH_TYPE_AT25QF" display="Renesas Electronics AT25QF" value="NOR_FLASH_TYPE_AT25QF"/>
            <option id="NOR_FLASH_CFG_DEVICE.NOR_FLASH_TYPE_MX25L" display="Macronix MX25L" value="NOR_FLASH_TYPE_MX25L"/>
            <option id="NOR_FLASH_CFG_DEVICE.NOR_FLASH_TYPE_MX66L" display="Macronix MX66L" value="NOR_FLASH_TYPE_MX66L"/>
            <option id="NOR_FLASH_CFG_DEVICE.NOR_FLASH_TYPE_MX25R" display="Macronix MX25R" value="NOR_FLASH_TYPE_MX25R"/>
            <description>Select serial flash memory device to be controlled.</description>
        </property>
        <property id="NOR_FLASH_CFG_SIZE" display="Select serial flash memory capacity" default="NOR_FLASH_SIZE_64M" type="combobox">
            <option id="NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_4M" display="4M-bit" value="NOR_FLASH_SIZE_4M"/>
            <option id="NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_8M" display="8M-bit" value="NOR_FLASH_SIZE_8M"/>
            <option id="NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_16M" display="16M-bit" value="NOR_FLASH_SIZE_16M"/>
            <option id="NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_32M" display="32M-bit" value="NOR_FLASH_SIZE_32M"/>
            <option id="NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_64M" display="64M-bit" value="NOR_FLASH_SIZE_64M"/>
            <option id="NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_128M" display="128M-bit" value="NOR_FLASH_SIZE_128M"/>
            <option id="NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_256M" display="256M-bit" value="NOR_FLASH_SIZE_256M"/>
            <option id="NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_512M" display="512M-bit" value="NOR_FLASH_SIZE_512M"/>
            <option id="NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_1G" display="1G-bit" value="NOR_FLASH_SIZE_1G"/>
            <constraint display="Select memory capacity error" actionOnFail="error">(("${NOR_FLASH_CFG_DEVICE}" == "${NOR_FLASH_CFG_DEVICE.NOR_FLASH_TYPE_AT25SF}") &amp;&amp; (("${NOR_FLASH_CFG_SIZE}" == "${NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_4M}") || ("${NOR_FLASH_CFG_SIZE}" == "${NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_8M}") || ("${NOR_FLASH_CFG_SIZE}" == "${NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_16M}") || ("${NOR_FLASH_CFG_SIZE}" == "${NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_32M}") || ("${NOR_FLASH_CFG_SIZE}" == "${NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_64M}"))) || (("${NOR_FLASH_CFG_DEVICE}" == "${NOR_FLASH_CFG_DEVICE.NOR_FLASH_TYPE_AT25QF}") &amp;&amp; ("${NOR_FLASH_CFG_SIZE}" == "${NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_64M}")) || (("${NOR_FLASH_CFG_DEVICE}" == "${NOR_FLASH_CFG_DEVICE.NOR_FLASH_TYPE_MX25L}") &amp;&amp; (("${NOR_FLASH_CFG_SIZE}" == "${NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_32M}") || ("${NOR_FLASH_CFG_SIZE}" == "${NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_64M}") || ("${NOR_FLASH_CFG_SIZE}" == "${NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_128M}") || ("${NOR_FLASH_CFG_SIZE}" == "${NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_256M}") || ("${NOR_FLASH_CFG_SIZE}" == "${NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_512M}"))) || (("${NOR_FLASH_CFG_DEVICE}" == "${NOR_FLASH_CFG_DEVICE.NOR_FLASH_TYPE_MX66L}") &amp;&amp; ("${NOR_FLASH_CFG_SIZE}" == "${NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_1G}")) || (("${NOR_FLASH_CFG_DEVICE}" == "${NOR_FLASH_CFG_DEVICE.NOR_FLASH_TYPE_MX25R}") &amp;&amp; ("${NOR_FLASH_CFG_SIZE}" == "${NOR_FLASH_CFG_SIZE.NOR_FLASH_SIZE_64M}"))</constraint>
            <description>Select serial flash memory capacity to be controlled.</description>
        </property>
        <property id="NOR_FLASH_CFG_CS_PORTNO" display="CS Port Number" default="0" type="combobox">
            <option id="NOR_FLASH_CFG_CS_PORTNO.0" display="PORT0" value="0"/>
            <option id="NOR_FLASH_CFG_CS_PORTNO.1" display="PORT1" value="1"/>
            <option id="NOR_FLASH_CFG_CS_PORTNO.2" display="PORT2" value="2"/>
            <option id="NOR_FLASH_CFG_CS_PORTNO.3" display="PORT3" value="3"/>
            <option id="NOR_FLASH_CFG_CS_PORTNO.4" display="PORT4" value="4"/>
            <option id="NOR_FLASH_CFG_CS_PORTNO.5" display="PORT5" value="5"/>
            <option id="NOR_FLASH_CFG_CS_PORTNO.6" display="PORT6" value="6"/>
            <option id="NOR_FLASH_CFG_CS_PORTNO.7" display="PORT7" value="7"/>
            <option id="NOR_FLASH_CFG_CS_PORTNO.8" display="PORT8" value="8"/>
            <option id="NOR_FLASH_CFG_CS_PORTNO.9" display="PORT9" value="9"/>
            <option id="NOR_FLASH_CFG_CS_PORTNO.10" display="PORT10" value="10"/>
            <option id="NOR_FLASH_CFG_CS_PORTNO.11" display="PORT11" value="11"/>
            <option id="NOR_FLASH_CFG_CS_PORTNO.12" display="PORT12" value="12"/>
            <option id="NOR_FLASH_CFG_CS_PORTNO.13" display="PORT13" value="13"/>
            <option id="NOR_FLASH_CFG_CS_PORTNO.14" display="PORT14" value="14"/>
            <option id="NOR_FLASH_CFG_CS_PORTNO.15" display="PORT15" value="15"/>
            <description>Configure Device Port Number
Depending on the MCU used
0 - 15
Default value 0 is for reference only, user needs to assign a value of port used for SS# according to the MCU used.</description>
        </property>
        <property id="NOR_FLASH_CFG_CS_BITNO" display="CS Bit Number" default="6" type="combobox">
            <option id="NOR_FLASH_CFG_CS_BITNO.0" display="BIT0" value="0"/>
            <option id="NOR_FLASH_CFG_CS_BITNO.1" display="BIT1" value="1"/>
            <option id="NOR_FLASH_CFG_CS_BITNO.2" display="BIT2" value="2"/>
            <option id="NOR_FLASH_CFG_CS_BITNO.3" display="BIT3" value="3"/>
            <option id="NOR_FLASH_CFG_CS_BITNO.4" display="BIT4" value="4"/>
            <option id="NOR_FLASH_CFG_CS_BITNO.5" display="BIT5" value="5"/>
            <option id="NOR_FLASH_CFG_CS_BITNO.6" display="BIT6" value="6"/>
            <option id="NOR_FLASH_CFG_CS_BITNO.7" display="BIT7" value="7"/>
            <description>Configure Device Bit Number
Depending on the MCU used
0 - 7</description>
        </property>
        <property id="NOR_FLASH_CFG_MODE_TRNS" display="Data transfer mode" default="NOR_FLASH_TRNS_CPU" type="combobox">
            <option id="NOR_FLASH_CFG_MODE_TRNS.NOR_FLASH_TRNS_CPU" display="CPU transfer (Software transfer)" value="NOR_FLASH_TRNS_CPU"/>
            <option id="NOR_FLASH_CFG_MODE_TRNS.NOR_FLASH_TRNS_DTC" display="DTC transfer" value="NOR_FLASH_TRNS_DTC"/>
            <description>Defines the method used to transfer data to the MCU's on-chip RAM.
Choose one of the following settings:
NOR_FLASH_TRNS_CPU: CPU transfer (Software transfer)
NOR_FLASH_TRNS_DTC: DTC transfer</description>
        </property>
        <property id="NOR_FLASH_CFG_DRVR_CH" display="SPI(CSI) channel number" default="NOR_FLASH_DRVR_CH3" type="combobox">
            <option id="NOR_FLASH_CFG_DRVR_CH.NOR_FLASH_DRVR_CH0" display="Channel 0" value="NOR_FLASH_DRVR_CH0"/>
            <option id="NOR_FLASH_CFG_DRVR_CH.NOR_FLASH_DRVR_CH1" display="Channel 1" value="NOR_FLASH_DRVR_CH1"/>
            <option id="NOR_FLASH_CFG_DRVR_CH.NOR_FLASH_DRVR_CH2" display="Channel 2" value="NOR_FLASH_DRVR_CH2"/>
            <option id="NOR_FLASH_CFG_DRVR_CH.NOR_FLASH_DRVR_CH3" display="Channel 3" value="NOR_FLASH_DRVR_CH3"/>
            <option id="NOR_FLASH_CFG_DRVR_CH.NOR_FLASH_DRVR_CH4" display="Channel 4" value="NOR_FLASH_DRVR_CH4"/>
            <option id="NOR_FLASH_CFG_DRVR_CH.NOR_FLASH_DRVR_CH5" display="Channel 5" value="NOR_FLASH_DRVR_CH5"/>
            <option id="NOR_FLASH_CFG_DRVR_CH.NOR_FLASH_DRVR_CH6" display="Channel 6" value="NOR_FLASH_DRVR_CH6"/>
            <option id="NOR_FLASH_CFG_DRVR_CH.NOR_FLASH_DRVR_CH7" display="Channel 7" value="NOR_FLASH_DRVR_CH7"/>
            <description>Please specify the channel number used for SPI (CSI) communication.
Choose one of the following settings:
Channel 0: CSI00
Channel 1: CSI01
Channel 2: CSI10
Channel 3: CSI11
Channel 4: CSI20
Channel 5: CSI21
Channel 6: CSI30
Channel 7: CSI31</description>
        </property>
        <property id="NOR_FLASH_CFG_DTCD_NO" display="DTC Control Data Number" default="0" type="textbox">
            <constraint display="Value must be an integer" actionOnFail="error">testInteger("${NOR_FLASH_CFG_DTCD_NO}")</constraint>
            <constraint display="Value must be in the range 0 ~ 22" actionOnFail="error">("${NOR_FLASH_CFG_DTCD_NO}" &gt;= 0) &amp;&amp; ("${NOR_FLASH_CFG_DTCD_NO}" &lt;= 22)</constraint>
            <description>Select DTC control data number
0 - 22</description>
        </property>
    </configuration>
</module>
